<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The addon (and the media CDNs) are reached over the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Hybrid app, one APK for both form factors:
        - leanback is NOT required, so phones can install it;
        - touchscreen is NOT required, so Android TV boxes can install it.
      Play Store uses these two flags to decide which devices see the app.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".StreamflixApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Streamflix">

        <!--
          Single activity for the catalogue. `configChanges` avoids a full
          recomposition (and a re-fetch) when a TV box switches resolution or a
          phone rotates; the UI is already responsive.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Streamflix">

            <!-- Phone / tablet launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android TV launcher (Leanback): appears in the TV home row. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Player lives in its own activity so the D-Pad focus graph starts
          clean, the screen can be kept awake independently, and pressing BACK
          releases the decoder without touching the catalogue state.
        -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="false"
            android:theme="@style/Theme.Streamflix.Player" />
    </application>
</manifest>
