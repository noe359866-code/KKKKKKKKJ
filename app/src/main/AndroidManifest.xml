<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- El addon y los CDN de vídeo necesitan acceso a la red. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Distribución exclusiva para Android TV:
        - Leanback es obligatorio: Google Play no ofrece la app a móviles/tablets;
        - la pantalla táctil NO es obligatoria: se navega con el mando (D-Pad).
      La instalación por ADB no aplica los filtros de Google Play; MainActivity
      también comprueba el entorno y muestra una salida en dispositivos no TV.
    -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".StreamflixApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Streamflix">

        <!--
          Única entrada de la app: la fila de aplicaciones de Android TV.
          No se registra LAUNCHER, por lo que no aparece en el launcher móvil.
          El banner rectangular es obligatorio para esta entrada.
        -->
        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Streamflix">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          El reproductor conserva su propio grafo de foco y libera el decoder
          al volver con BACK. No tiene entrada de launcher ni es exportado.
        -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Streamflix.Player" />
    </application>
</manifest>
