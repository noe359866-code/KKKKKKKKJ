# ---------------------------------------------------------------------------
# Firma del APK/AAB de release  ·  copiar a keystore.properties (ignorado por git)
# ---------------------------------------------------------------------------
# Genera el keystore una sola vez (guárdalo fuera del repo y haz copia de
# seguridad: sin él no podrás publicar actualizaciones de la misma app):
#
#   keytool -genkeypair -v \
#     -keystore release.keystore -alias streamflix \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Y rellena esto:
RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=cambia-esta-clave
RELEASE_KEY_ALIAS=streamflix
RELEASE_KEY_PASSWORD=cambia-esta-clave

# Opcional: URL de producción del addon para este build.
# (También vale -PreleaseAddonBaseUrl=… o la variable ADDON_BASE_URL.)
#releaseAddonBaseUrl=https://addon.tu-dominio.com
