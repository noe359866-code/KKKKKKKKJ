      "posterShape": "poster",
      "order": 3,
      "source": { "kind": "cinemeta", "type": "movie", "id": "imdbRating" }
    },
    {
      "type": "series",
      "id": "top",
      "name": "Series populares",
      "posterShape": "poster",
      "order": 4,
      "source": { "kind": "cinemeta", "type": "series", "id": "top" }
    },
    {
      "type": "anime",
      "id": "top",
      "name": "Anime en emisión",
      "posterShape": "poster",
      "order": 5,
      "source": { "kind": "cinemeta", "type": "series", "id": "top", "genre": "Animation" }
    },
    {
      "type": "anime",
      "id": "imdbRating",
      "name": "Anime mejor valorado",
      "posterShape": "poster",
      "order": 6,
      "source": { "kind": "cinemeta", "type": "series", "id": "imdbRating", "genre": "Animation" }
    }
  ]
