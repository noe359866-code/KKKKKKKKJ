      "order": 1,
      "genres": ["Deportes", "Canales", "Eventos"],
      "source": { "kind": "local" }
    },
    {
      "type": "movie",
      "id": "top",
      "name": "Películas populares",
      "posterShape": "poster",
      "order": 2,
      "source": { "kind": "cinemeta", "type": "movie", "id": "top" }
    },
    {
      "type": "movie",
      "id": "imdbRating",
