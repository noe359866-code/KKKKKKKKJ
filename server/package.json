{
  "name": "streamflix-stremio-addon",
  "version": "0.1.0",
  "private": true,
  "description": "Catalog and metadata Stremio addon backend; playback sources come from addons configured by the client.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "preview": "HOST=0.0.0.0 PORT=8899 node src/server.js",
    "test": "LOG_LEVEL=error NODE_ENV=test node --test",
    "cache:stats": "node scripts/cache-stats.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "keywords": [
    "stremio",
    "stremio-addon",
    "android-tv",
    "catalogs",
    "metadata"
  ],
  "license": "Apache-2.0"
}
