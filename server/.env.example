# ---------------------------------------------------------------------------
# Streamflix Reborn · Stremio Addon — environment template
# Copy to .env (never commit it) or export the vars in your process manager.
# ---------------------------------------------------------------------------

# --- HTTP ------------------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=7000
# Public origin used in the manifest; leave empty to derive it from the request.
PUBLIC_URL=
# Comma-separated list or * for any origin.
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
# Set to enable /admin/* (use a long random string).
ADMIN_TOKEN=
PROXY_ENABLED=true

# --- Cache TTL (hours) -----------------------------------------------------
# Live TV / sports: valid window 2-4 h. The .m3u8 must come from a cache hit,
# but those URLs rotate, so anything outside 2-4 stops the boot.
CACHE_TTL_LIVE_HOURS=2
# Movies / series / anime: valid window 2-6 h (stable links).
CACHE_TTL_VOD_HOURS=6
# Negative cache for "no source found" (seconds).
CACHE_TTL_MISS_SECONDS=120
CACHE_MAX_ENTRIES=5000
CACHE_SWEEP_SECONDS=60
# Serve stale data for ttl * factor while refreshing in background.
CACHE_STALE_FACTOR=1.25

# --- Catálogos (Cinemeta) --------------------------------------------------
# Base del addon oficial de metadatos de Stremio. Los tests la apuntan a un
# mock local; en producción no hace falta cambiarla.
CINEMETA_BASE=https://v3-cinemeta.strem.io
CINEMETA_TIMEOUT_MS=6000
# TTL de las filas del Home (minutos). Las filas cambian despacio.
CATALOG_TTL_MINUTES=30
# Las búsquedas cambian más rápido: ventana corta.
CATALOG_SEARCH_TTL_MINUTES=5
# Fichas (/meta) con sinopsis y episodios: se cachean un día.
CATALOG_META_TTL_HOURS=24
# Ventana del modo degradado cuando Cinemeta no responde (segundos).
CATALOG_MISS_SECONDS=60
# Tope de metas por catálogo (página de Stremio).
CATALOG_PAGE_SIZE=100
# Registro de filas publicadas (incluye el bloque `addons` de terceros).
CATALOGS_CONFIG=./config/catalogs.json
# Canales de TV en vivo y deportes curados.
LIVE_CATALOG_PATH=./config/live-catalog.json
# Addons de terceros cuyo manifest se lee al arrancar (Netflix, Disney+…).
# Su manifest se cachea en disco para tolerar reinicios sin red.
CATALOG_REMOTE_TIMEOUT_MS=8000
CATALOG_REMOTE_TTL_HOURS=6
# CATALOG_REMOTE_CACHE=./.cache/remote-catalogs.json

# --- Python bridge ---------------------------------------------------------
SCRAPER_PYTHON=python3
# Absolute or relative path to the scrapers folder.
SCRAPER_DIR=./scrapers
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_CONCURRENCY=4

# --- Streams / failover ----------------------------------------------------
# 8 s por proveedor: al vencer, el scraper se mata y se sirve el failover.
PROVIDER_TIMEOUT_MS=8000
MIN_PROVIDERS_FOR_FAST_RETURN=2
FAST_RETURN_GRACE_MS=1500
# Headers used when a provider does not define its own.
STREAM_USER_AGENT=Mozilla/5.0 (Linux; Android 12; Android TV) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
STREAM_REFERER=

# --- Proveedor real: TV en Vivo (tvenvivo.org) -----------------------------
# Base del sitio (los tests la apuntan a un fixture local).
TVENVIVO_BASE=https://www.tvenvivo.org
# TTL del índice de canales en disco (segundos, 0 = sin caché).
TVENVIVO_INDEX_TTL_SECONDS=21600
# TVENVIVO_INDEX_CACHE=/tmp/streamflix-tvenvivo-index.json
# Topes al resolver el reproductor (wrapper -> iframe -> .m3u8).
TVENVIVO_MAX_DOCS=8
TVENVIVO_MAX_DEPTH=3

# --- Proveedor real: DeporteLibre (deportelibre.top) -----------------------
DEPORTELIBRE_BASE=https://deportelibre.top
# Catálogo de canales 24/7 dentro del sitio.
DEPORTELIBRE_CHANNELS_PATH=/stream/
DEPORTELIBRE_INDEX_TTL_SECONDS=21600
# DEPORTELIBRE_INDEX_CACHE=/tmp/streamflix-deportelibre-index.json
# Opciones por canal (embed2…embedN) y saltos dentro de cada reproductor.
DEPORTELIBRE_MAX_OPTIONS=4
DEPORTELIBRE_MAX_DEPTH=2
DEPORTELIBRE_MAX_DOCS=12

# --- Proveedor real: Fútbol Libre (futbolibre.live) ------------------------
# Base del sitio de canales (los tests la apuntan a un fixture local).
FUTBOLIBRE_BASE=https://futbolibre.live
# Agenda de partidos del backend: un partido, varias señales.
FUTBOLIBRE_AGENDA_URL=https://la18hd.su/eventos/json/agenda123.json
# Catálogo de canales: TTL largo. Agenda: TTL corto (cambia durante el día).
FUTBOLIBRE_INDEX_TTL_SECONDS=21600
FUTBOLIBRE_AGENDA_TTL_SECONDS=600
# FUTBOLIBRE_INDEX_CACHE=/tmp/streamflix-futbolibre-index.json
# FUTBOLIBRE_AGENDA_CACHE=/tmp/streamflix-futbolibre-agenda.json
# Señales por contenido, saltos por reproductor y documentos totales.
FUTBOLIBRE_MAX_SIGNALS=6
FUTBOLIBRE_MAX_DEPTH=2
FUTBOLIBRE_MAX_DOCS=12

# --- Proveedores reales: anime (VOD) ---------------------------------------
# AnimeFLV (animeflv.net) — catálogo por slug + servidores en base64.
ANIMEFLV_BASE=https://www3.animeflv.net
# ANIMEFLV_VER_PATH=/ver/{slug}-{episode}
# ANIMEFLV_SEARCH_PATH=/browse?q={query}
ANIMEFLV_MAX_SERVERS=6
ANIMEFLV_PARALLEL=4

# JkAnime (jkanime.net) — /<slug>/<episodio>/
JKANIME_BASE=https://jkanime.net
# JKANIME_EPISODE_PATH=/{slug}/{episode}/
# JKANIME_SEARCH_PATH=/buscar/{query}/
JKANIME_MAX_SERVERS=6
JKANIME_PARALLEL=4

# MonosChinos (monoschinos.st, antes monoschinos2.com) — botones data-player.
MONOSCHINOS_BASE=https://monoschinos.st
# MONOSCHINOS_EPISODE_PATH=/ver/{slug}-episodio-{episode}
# MONOSCHINOS_SEARCH_PATH=/buscar?q={query}
# MONOSCHINOS_PLAYER_PATH=/reproductor?url={url}
MONOSCHINOS_MAX_SERVERS=6
MONOSCHINOS_PARALLEL=4

# --- Proveedores reales: películas y series (VOD) --------------------------
# TMDB es opcional: sin clave los ids IMDb (gnula:tt0145487) no se resuelven,
# pero los slugs y la búsqueda por título del propio sitio funcionan igual.
TMDB_API_KEY=

# Gnula (ww3.gnulahd.nu) — ficha + API GNRD del reproductor.
GNULA_BASE=https://ww3.gnulahd.nu
# GNULA_MIRRORS=https://otro-dominio.example,https://otro-mas.example

# Cuevana (cue.cuevana3.nu) — `showEmbed` en base64.
CUEVANA_BASE=https://cue.cuevana3.nu
# CUEVANA_MIRRORS=

# PelisPlus / PelisPlusHD (pelisplushd.la).
PELISPLUSHD_BASE=https://www.pelisplushd.la
# PELISPLUSHD_MIRRORS=https://ww3.pelisplushd.nu

# Repelis — el dominio rota: hay que poner el que esté vivo.
REPELIS_BASE=https://repelis.live
# REPELIS_MIRRORS=https://repelis2.example,https://repelis3.example

# PeliculasFlix — API GraphQL propia.
PELICULASFLIX_BASE=https://peliculasflix.co
PELICULASFLIX_API=https://fluxcedene.net/api/gql
# Clave pública `x-access-platform` que manda el propio sitio.
PELICULASFLIX_ACCESS=lDakkGUZx7_nX25Nv1CJVbz_ZAjMKMTcwNTQyMzU4Nw==
# PELICULASFLIX_MIRRORS=

# PelisJuanita (pelisjuanita.org).
PELISJUANITA_BASE=https://pelisjuanita.org
# PELISJUANITA_MIRRORS=


# --- Demo scrapers (remove/disable them in production) ---------------------
DEMO_DELAY_MS=350

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
LOG_JSON=true
