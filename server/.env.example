# Streamflix · backend de catálogos/metadatos Stremio (sin scrapers ni streams)
NODE_ENV=production
HOST=0.0.0.0
PORT=7000
PUBLIC_URL=
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
ADMIN_TOKEN=

# Catálogos y fichas de Cinemeta
CINEMETA_BASE=https://v3-cinemeta.strem.io
CINEMETA_TIMEOUT_MS=6000
CATALOG_TTL_MINUTES=30
CATALOG_SEARCH_TTL_MINUTES=5
CATALOG_META_TTL_HOURS=24
CATALOG_MISS_SECONDS=60
CATALOG_PAGE_SIZE=100
CATALOGS_CONFIG=./config/catalogs.json
CATALOG_REMOTE_TIMEOUT_MS=8000
CATALOG_REMOTE_TTL_HOURS=6
# CATALOG_REMOTE_CACHE=./.cache/remote-catalogs.json

# Caché del backend
CACHE_TTL_MISS_SECONDS=120
CACHE_MAX_ENTRIES=5000
CACHE_SWEEP_SECONDS=60
CACHE_STALE_FACTOR=1.25

# Proxy HTTP opcional para URLs aportadas por otros addons (no descubre fuentes)
PROXY_ENABLED=true
PROXY_TIMEOUT_MS=15000
PROXY_USER_AGENT=Mozilla/5.0 (Linux; Android 12; Android TV) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
PROXY_REFERER=
